          let voteAfter = pollRequesterVoteAfter();
          return exists(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
            validPollVote(voteBefore.data) &&
            validPollVote(voteAfter.data) &&
            voteAfter.data.ballotKey == voteBefore.data.ballotKey &&
            voteAfter.data.createdAt == voteBefore.data.createdAt &&
            voteAfter.data.updatedAt == request.time &&
            voteAfter.data.diff(voteBefore.data).affectedKeys().hasOnly(['choice', 'updatedAt']) &&
            voteAfter.data.diff(voteBefore.data).affectedKeys().hasAll(['choice', 'updatedAt']) &&
            validPollBallotTransition(
