      allow create: if googleAccount() &&
        validRoomId(roomId) &&
        validPollRoom(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.locked == false &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        validInitialPollBallot(roomId);

      allow update: if pollOwnerLockUpdate();
      allow delete: if false;

      match /ballots/{ballotId} {
        function pollBallotParentBefore() {
          return get(/databases/$(database)/documents/pollRooms/$(roomId));
        }

        function pollBallotParentAfter() {
          return getAfter(/databases/$(database)/documents/pollRooms/$(roomId));
        }

        function pollRequesterVoteBefore() {
          return get(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid));
        }

        function pollRequesterVoteAfter() {
          return getAfter(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid));
        }

        function pollBallotOpenBeforeAndAfter() {
          return exists(/databases/$(database)/documents/pollRooms/$(roomId)) &&
            existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)) &&
            pollBallotParentBefore().data.locked == false &&
            pollBallotParentAfter().data.locked == false;
        }

        function pollFirstBallotUpdate() {
          let voteAfter = pollRequesterVoteAfter();
          return !exists(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
            existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
            validPollVote(voteAfter.data) &&
            voteAfter.data.createdAt == request.time &&
            voteAfter.data.updatedAt == request.time &&
