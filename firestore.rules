      allow update: if raidLootOwnerUpdate();

      allow delete: if raidLootOwner() && noRaidLootMembersExistAfter(roomId);

      match /members/{seat} {
        function raidLootParentBefore() {
          return get(/databases/$(database)/documents/raidLootRooms/$(roomId));
        }

        function raidLootParentAfter() {
          return getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId));
        }

        function raidLootParentOwner() {
          return signedIn() && raidLootParentBefore().data.ownerUid == request.auth.uid;
