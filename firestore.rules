        return pollOwner() &&
          googleAccount() &&
          validPollRoom(request.resource.data) &&
          request.resource.data.createdAt == resource.data.createdAt &&
          changes.hasOnly(['locked', 'updatedAt']) &&
          changes.hasAll(['locked', 'updatedAt']) &&
          request.resource.data.updatedAt == request.time;
      }

      allow get: if signedIn() && validRoomId(roomId);
      allow list: if googleAccount() &&
        resource.data.ownerUid == request.auth.uid &&
