        function noOtherRaidLootSeatClaimedByRequester() {
          return (seat == 'MT' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/MT).data.editorUid != request.auth.uid) &&
            (seat == 'ST' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/ST).data.editorUid != request.auth.uid) &&
            (seat == 'MH' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/MH).data.editorUid != request.auth.uid) &&
            (seat == 'SH' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/SH).data.editorUid != request.auth.uid) &&
            (seat == 'D1' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D1).data.editorUid != request.auth.uid) &&
            (seat == 'D2' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D2).data.editorUid != request.auth.uid) &&
            (seat == 'D3' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D3).data.editorUid != request.auth.uid) &&
            (seat == 'D4' || getAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D4).data.editorUid != request.auth.uid);
        }

        function raidLootParticipantMemberUpdate() {
          let changes = request.resource.data.diff(resource.data).affectedKeys();
          return signedIn() &&
            raidLootParentBefore().data.locked == false &&
            validRaidLootMember(request.resource.data, seat) &&
            request.resource.data.seat == resource.data.seat &&
            request.resource.data.nickname == resource.data.nickname &&
            request.resource.data.job == resource.data.job &&
            request.resource.data.createdAt == resource.data.createdAt &&
            changes.hasOnly(['editorUid', 'gear', 'submitted', 'updatedAt']) &&
            changes.hasAll(['updatedAt']) &&
            (
              (
                resource.data.editorUid == '' &&
                request.resource.data.editorUid == request.auth.uid &&
