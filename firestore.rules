          validRoomId(roomId) &&
          exists(/databases/$(database)/documents/pollRooms/$(roomId)) &&
          pollBallotParentBefore().data.ownerUid == request.auth.uid;
        allow list: if false;

        allow create: if ballotId == 'current' &&
          googleAccount() &&
          validRoomId(roomId) &&
          validPollBallot(request.resource.data) &&
          request.resource.data.votes.size() == 0 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          !exists(/databases/$(database)/documents/pollRooms/$(roomId)) &&
          existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)) &&
          pollBallotParentAfter().data.ownerUid == request.auth.uid;

        allow update: if ballotId == 'current' &&
          signedIn() &&
          validRoomId(roomId) &&
          pollBallotOpenBeforeAndAfter() &&
          (
            (
              !exists(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
              pollFirstBallotUpdate()
            ) ||
            (
              exists(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
              existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/votes/$(request.auth.uid)) &&
              pollChangedBallotUpdate()
            )
          );
        allow delete: if false;
      }

      match /votes/{voterUid} {
        function pollVoteParentBefore() {
          return get(/databases/$(database)/documents/pollRooms/$(roomId));
        }

        function pollVoteParentAfter() {
          return getAfter(/databases/$(database)/documents/pollRooms/$(roomId));
        }

        function pollBallotBefore() {
          return get(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current);
        }

        function pollBallotAfter() {
          return getAfter(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current);
        }

        function pollVoteOpenBeforeAndAfter() {
          return exists(/databases/$(database)/documents/pollRooms/$(roomId)) &&
            existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)) &&
            pollVoteParentBefore().data.locked == false &&
            pollVoteParentAfter().data.locked == false;
        }

        function pollFirstVoteCreate() {
          let ballotBefore = pollBallotBefore();
          let ballotAfter = pollBallotAfter();
          return validPollVote(request.resource.data) &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.updatedAt == request.time &&
            exists(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current) &&
            existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current) &&
            validPollBallotTransition(
