              )
            ) &&
            request.resource.data.updatedAt == request.time;
        }

        function raidLootOwnerMemberUpdate() {
          let changes = request.resource.data.diff(resource.data).affectedKeys();
          return raidLootParentOwner() &&
            validRaidLootMember(request.resource.data, seat) &&
            request.resource.data.seat == resource.data.seat &&
            request.resource.data.nickname == resource.data.nickname &&
            request.resource.data.job == resource.data.job &&
            request.resource.data.createdAt == resource.data.createdAt &&
            changes.hasOnly(['editorUid', 'gear', 'submitted', 'updatedAt']) &&
            changes.hasAll(['updatedAt']) &&
            request.resource.data.updatedAt == request.time;
        }

        allow get: if signedIn() && validRoomId(roomId) && validRaidLootSeat(seat);
        allow list: if signedIn() &&
          validRoomId(roomId) &&
          request.query.limit <= 8;

        allow create: if googleAccount() &&
          validRoomId(roomId) &&
          validRaidLootMember(request.resource.data, seat) &&
          request.resource.data.editorUid == '' &&
          request.resource.data.gear == 'XXXXXXXXXXX' &&
          request.resource.data.submitted == false &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          !exists(/databases/$(database)/documents/raidLootRooms/$(roomId)) &&
          raidLootParentAfter().data.ownerUid == request.auth.uid;

        allow update: if raidLootParticipantMemberUpdate() || raidLootOwnerMemberUpdate();

        allow delete: if raidLootParentOwner() &&
          !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId));
      }

      match /events/{eventId} {
        function raidLootEventParentBefore() {
          return get(/databases/$(database)/documents/raidLootRooms/$(roomId));
        }

        function raidLootEventParentOwner() {
          return signedIn() && raidLootEventParentBefore().data.ownerUid == request.auth.uid;
        }

        function validRaidLootUndoTarget() {
          let target = get(/databases/$(database)/documents/raidLootRooms/$(roomId)/events/$(request.resource.data.targetEventId));
          return target.data.action != 'undo' &&
            (
              target.data.action == 'award' ||
              target.data.action == 'skip'
            );
        }

        function validRaidLootDirectWeaponRecipient() {
          return request.resource.data.action != 'award' ||
            request.resource.data.dropType != 'direct_weapon' ||
            get(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/$(request.resource.data.seat)).data.job == request.resource.data.job;
        }

        allow get: if signedIn() &&
          validRoomId(roomId) &&
          validRaidLootEventId(eventId) &&
          exists(/databases/$(database)/documents/raidLootRooms/$(roomId));
        allow list: if signedIn() &&
          validRoomId(roomId) &&
          exists(/databases/$(database)/documents/raidLootRooms/$(roomId)) &&
          request.query.limit <= 480;

        allow create: if googleAccount() &&
          validRoomId(roomId) &&
          validRaidLootEventId(eventId) &&
          raidLootEventParentOwner() &&
          validRaidLootEvent(request.resource.data) &&
          validRaidLootDirectWeaponRecipient() &&
          (
            request.resource.data.action != 'undo' ||
            validRaidLootUndoTarget()
          ) &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time;

        allow update: if false;

        allow delete: if raidLootEventParentOwner() &&
          !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId));
      }
    }

    match /pollRooms/{roomId} {
      function pollOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function pollOwnerLockUpdate() {
