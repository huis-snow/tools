        }

        function pollVoteChange() {
          let changes = request.resource.data.diff(resource.data).affectedKeys();
          let ballotBefore = pollBallotBefore();
          let ballotAfter = pollBallotAfter();
          return validPollVote(resource.data) &&
            validPollVote(request.resource.data) &&
            request.resource.data.ballotKey == resource.data.ballotKey &&
            request.resource.data.createdAt == resource.data.createdAt &&
            request.resource.data.updatedAt == request.time &&
            changes.hasOnly(['choice', 'updatedAt']) &&
            changes.hasAll(['choice', 'updatedAt']) &&
            exists(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current) &&
            existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current) &&
            validPollBallotTransition(
              ballotBefore.data,
              ballotAfter.data,
              resource.data.ballotKey,
              resource.data.choice,
              request.resource.data.choice,
              false
            );
        }

        allow get: if signedIn() &&
          validRoomId(roomId) &&
          voterUid == request.auth.uid &&
          exists(/databases/$(database)/documents/pollRooms/$(roomId));
        allow list: if false;

        allow create: if signedIn() &&
          validRoomId(roomId) &&
          voterUid == request.auth.uid &&
          pollVoteOpenBeforeAndAfter() &&
          pollFirstVoteCreate();
        allow update: if signedIn() &&
          validRoomId(roomId) &&
          voterUid == request.auth.uid &&
          pollVoteOpenBeforeAndAfter() &&
          pollVoteChange();
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
