rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function googleAccount() {
      return signedIn() &&
        request.auth.token.firebase.identities is map &&
        'google.com' in request.auth.token.firebase.identities;
    }

    function validRoomId(roomId) {
      return roomId.matches('[A-Za-z0-9_-]{22}');
    }

    function validRoom(data) {
      return data.keys().hasAll([
          'version',
          'title',
          'timezone',
          'startHour',
          'startDay',
          'ownerUid',
          'locked',
          'createdAt',
          'updatedAt',
          'responses'
        ]) &&
        data.keys().hasOnly([
          'version',
          'title',
          'timezone',
          'startHour',
          'startDay',
          'startDate',
          'ownerUid',
          'locked',
          'createdAt',
          'updatedAt',
          'responses'
        ]) &&
        data.version is int &&
        data.version == 1 &&
        data.title is string &&
        data.title == data.title.trim() &&
        data.title.size() > 0 &&
        data.title.size() <= 60 &&
        data.timezone is string &&
        data.timezone.matches('[-A-Za-z0-9_+./]{1,40}') &&
        data.startHour is int &&
        data.startHour >= 0 &&
        data.startHour <= 23 &&
        data.startDay is int &&
        data.startDay >= 0 &&
        data.startDay <= 6 &&
        (
          !('startDate' in data) ||
          (
            data.startDate is string &&
            data.startDate.matches('[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])')
          )
        ) &&
        data.ownerUid is string &&
        data.ownerUid.size() > 0 &&
        data.ownerUid.size() <= 128 &&
        data.locked is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp &&
        data.responses is map &&
        data.responses.size() <= 8;
    }

    function validResponse(data) {
      return data is map &&
        data.keys().hasAll(['nickname', 'slots', 'updatedAt']) &&
        data.keys().hasOnly(['nickname', 'slots', 'updatedAt']) &&
        data.nickname is string &&
        data.nickname == data.nickname.trim() &&
        data.nickname.size() > 0 &&
        data.nickname.size() <= 60 &&
        data.slots is string &&
        data.slots.matches('[A-Za-z0-9_-]{28}') &&
        data.updatedAt is timestamp &&
        data.updatedAt == request.time;
    }

    function validBisSeat(seat) {
      return seat == 'MT' ||
        seat == 'ST' ||
        seat == 'MH' ||
        seat == 'SH' ||
        seat == 'D1' ||
        seat == 'D2' ||
        seat == 'D3' ||
        seat == 'D4';
    }

    function validBisDropCounts(data) {
      return data is map &&
        data.keys().hasAll([
          'raid_weapon',
          'raid_head',
          'raid_body',
          'raid_hands',
          'raid_legs',
          'raid_feet',
          'raid_earrings',
          'raid_necklace',
          'raid_bracelets',
          'raid_ring',
          'upgrade_weapon',
          'upgrade_armor',
          'upgrade_accessory'
        ]) &&
        data.keys().hasOnly([
          'raid_weapon',
          'raid_head',
          'raid_body',
          'raid_hands',
          'raid_legs',
          'raid_feet',
          'raid_earrings',
          'raid_necklace',
          'raid_bracelets',
          'raid_ring',
          'upgrade_weapon',
          'upgrade_armor',
          'upgrade_accessory'
        ]) &&
        data.raid_weapon is int && data.raid_weapon >= 0 && data.raid_weapon <= 99 &&
        data.raid_head is int && data.raid_head >= 0 && data.raid_head <= 99 &&
        data.raid_body is int && data.raid_body >= 0 && data.raid_body <= 99 &&
        data.raid_hands is int && data.raid_hands >= 0 && data.raid_hands <= 99 &&
        data.raid_legs is int && data.raid_legs >= 0 && data.raid_legs <= 99 &&
        data.raid_feet is int && data.raid_feet >= 0 && data.raid_feet <= 99 &&
        data.raid_earrings is int && data.raid_earrings >= 0 && data.raid_earrings <= 99 &&
        data.raid_necklace is int && data.raid_necklace >= 0 && data.raid_necklace <= 99 &&
        data.raid_bracelets is int && data.raid_bracelets >= 0 && data.raid_bracelets <= 99 &&
        data.raid_ring is int && data.raid_ring >= 0 && data.raid_ring <= 99 &&
        data.upgrade_weapon is int && data.upgrade_weapon >= 0 && data.upgrade_weapon <= 99 &&
        data.upgrade_armor is int && data.upgrade_armor >= 0 && data.upgrade_armor <= 99 &&
        data.upgrade_accessory is int && data.upgrade_accessory >= 0 && data.upgrade_accessory <= 99;
    }

    function validBisAssignment(value) {
      return value is string &&
        value.size() <= 255 &&
        value.matches('((MT|ST|MH|SH|D1|D2|D3|D4)@(weapon|head|body|hands|legs|feet|earrings|necklace|bracelets|ring1|ring2)(,(MT|ST|MH|SH|D1|D2|D3|D4)@(weapon|head|body|hands|legs|feet|earrings|necklace|bracelets|ring1|ring2))*)?');
    }

    function validBisAssignments(data) {
      return data is map &&
        data.keys().hasAll([
          'raid_weapon',
          'raid_head',
          'raid_body',
          'raid_hands',
          'raid_legs',
          'raid_feet',
          'raid_earrings',
          'raid_necklace',
          'raid_bracelets',
          'raid_ring',
          'upgrade_weapon',
          'upgrade_armor',
          'upgrade_accessory'
        ]) &&
        data.keys().hasOnly([
          'raid_weapon',
          'raid_head',
          'raid_body',
          'raid_hands',
          'raid_legs',
          'raid_feet',
          'raid_earrings',
          'raid_necklace',
          'raid_bracelets',
          'raid_ring',
          'upgrade_weapon',
          'upgrade_armor',
          'upgrade_accessory'
        ]) &&
        validBisAssignment(data.raid_weapon) &&
        validBisAssignment(data.raid_head) &&
        validBisAssignment(data.raid_body) &&
        validBisAssignment(data.raid_hands) &&
        validBisAssignment(data.raid_legs) &&
        validBisAssignment(data.raid_feet) &&
        validBisAssignment(data.raid_earrings) &&
        validBisAssignment(data.raid_necklace) &&
        validBisAssignment(data.raid_bracelets) &&
        validBisAssignment(data.raid_ring) &&
        validBisAssignment(data.upgrade_weapon) &&
        validBisAssignment(data.upgrade_armor) &&
        validBisAssignment(data.upgrade_accessory);
    }

    function validBisDistribution(data) {
      return data is map &&
        data.keys().hasAll(['week', 'dropCounts', 'assignments']) &&
        data.keys().hasOnly(['week', 'dropCounts', 'assignments']) &&
        data.week is int &&
        data.week >= 1 &&
        data.week <= 99 &&
        validBisDropCounts(data.dropCounts) &&
        validBisAssignments(data.assignments);
    }

    function validBisRoom(data) {
      return data.keys().hasAll([
          'version',
          'title',
          'tier',
          'week',
          'ownerUid',
          'locked',
          'distribution',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'version',
          'title',
          'tier',
          'week',
          'ownerUid',
          'locked',
          'distribution',
          'createdAt',
          'updatedAt'
        ]) &&
        data.version is int &&
        data.version == 1 &&
        data.title is string &&
        data.title == data.title.trim() &&
        data.title.size() > 0 &&
        data.title.size() <= 60 &&
        data.tier is string &&
        data.tier == data.tier.trim() &&
        data.tier.size() > 0 &&
        data.tier.size() <= 60 &&
        data.week is int &&
        data.week >= 1 &&
        data.week <= 99 &&
        data.ownerUid is string &&
        data.ownerUid.size() > 0 &&
        data.ownerUid.size() <= 128 &&
        data.locked is bool &&
        validBisDistribution(data.distribution) &&
        data.distribution.week == data.week &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validBisMember(data, seat) {
      return data.keys().hasAll([
          'seat',
          'nickname',
          'job',
          'editorUid',
          'gear',
          'submitted',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'seat',
          'nickname',
          'job',
          'editorUid',
          'gear',
          'submitted',
          'updatedAt'
        ]) &&
        validBisSeat(seat) &&
        data.seat is string &&
        data.seat == seat &&
        data.nickname is string &&
        data.nickname == data.nickname.trim() &&
        data.nickname.size() > 0 &&
        data.nickname.size() <= 30 &&
        data.job is string &&
        data.job == data.job.trim() &&
        data.job.size() > 0 &&
        data.job.size() <= 30 &&
        data.editorUid is string &&
        data.editorUid.size() <= 128 &&
        data.gear is string &&
        data.gear.matches('[XCUR]{11}') &&
        data.submitted is bool &&
        (data.submitted == false || !data.gear.matches('.*X.*')) &&
        data.updatedAt is timestamp;
    }

    function allBisMembersExistAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/MT) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/ST) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/MH) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/SH) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D1) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D2) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D3) &&
        existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D4);
    }

    function noBisMembersExistAfter(roomId) {
      return !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/MT) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/ST) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/MH) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/SH) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D1) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D2) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D3) &&
        !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D4);
    }

    function validRaidLootSeat(seat) {
      return seat == 'MT' ||
        seat == 'ST' ||
        seat == 'MH' ||
        seat == 'SH' ||
        seat == 'D1' ||
        seat == 'D2' ||
        seat == 'D3' ||
        seat == 'D4';
    }

    function validRaidLootPolicy(data) {
      return data is map &&
        data.keys().hasAll(['preset', 'seatOrder']) &&
        data.keys().hasOnly(['preset', 'seatOrder']) &&
        data.preset is string &&
        (
          data.preset == 'manual' ||
          data.preset == 'fair' ||
          data.preset == 'progression' ||
          data.preset == 'custom'
        ) &&
        data.seatOrder is list &&
        data.seatOrder.size() == 8 &&
        'MT' in data.seatOrder &&
        'ST' in data.seatOrder &&
        'MH' in data.seatOrder &&
        'SH' in data.seatOrder &&
        'D1' in data.seatOrder &&
        'D2' in data.seatOrder &&
        'D3' in data.seatOrder &&
        'D4' in data.seatOrder;
    }

    function validRaidLootRoom(data) {
      return data.keys().hasAll([
          'version',
          'title',
          'tier',
          'startDate',
          'currentWeek',
          'ownerUid',
          'locked',
          'policy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'version',
          'title',
          'tier',
          'startDate',
          'currentWeek',
          'ownerUid',
          'locked',
          'policy',
          'createdAt',
          'updatedAt'
        ]) &&
        data.version is int &&
        data.version == 1 &&
        data.title is string &&
        data.title == data.title.trim() &&
        data.title.size() > 0 &&
        data.title.size() <= 60 &&
        data.tier is string &&
        data.tier == data.tier.trim() &&
        data.tier.size() > 0 &&
        data.tier.size() <= 60 &&
        data.startDate is string &&
        data.startDate.matches('[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
        data.currentWeek is int &&
        data.currentWeek >= 1 &&
        data.currentWeek <= 8 &&
        data.ownerUid is string &&
        data.ownerUid.size() > 0 &&
        data.ownerUid.size() <= 128 &&
        data.locked is bool &&
        validRaidLootPolicy(data.policy) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validRaidLootMember(data, seat) {
      return data.keys().hasAll([
          'seat',
          'nickname',
          'job',
          'editorUid',
          'gear',
          'submitted',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'seat',
          'nickname',
          'job',
          'editorUid',
          'gear',
          'submitted',
          'createdAt',
          'updatedAt'
        ]) &&
        validRaidLootSeat(seat) &&
        data.seat is string &&
        data.seat == seat &&
        data.nickname is string &&
        data.nickname == data.nickname.trim() &&
        data.nickname.size() > 0 &&
        data.nickname.size() <= 30 &&
        data.job is string &&
        data.job == data.job.trim() &&
        data.job.size() > 0 &&
        data.job.size() <= 30 &&
        data.editorUid is string &&
        data.editorUid.size() <= 128 &&
        data.gear is string &&
        data.gear.matches('[XCUR]{11}') &&
        data.submitted is bool &&
        (data.submitted == false || !data.gear.matches('.*X.*')) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function allRaidLootMembersExistAfter(roomId) {
      return existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/MT) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/ST) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/MH) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/SH) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D1) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D2) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D3) &&
        existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D4);
    }

    function noRaidLootMembersExistAfter(roomId) {
      return !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/MT) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/ST) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/MH) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/SH) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D1) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D2) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D3) &&
        !existsAfter(/databases/$(database)/documents/raidLootRooms/$(roomId)/members/D4);
    }

    function validRaidLootEventId(eventId) {
      return eventId.matches('[A-Za-z0-9_-]{22}');
    }

    function validRaidLootGearSlot(slot) {
      return slot == 'weapon' ||
        slot == 'head' ||
        slot == 'body' ||
        slot == 'hands' ||
        slot == 'legs' ||
        slot == 'feet' ||
        slot == 'earrings' ||
        slot == 'necklace' ||
        slot == 'bracelets' ||
        slot == 'ring1' ||
        slot == 'ring2';
    }

    function validRaidLootDropType(dropType) {
      return dropType == 'raid_earrings' ||
        dropType == 'raid_necklace' ||
        dropType == 'raid_bracelets' ||
        dropType == 'raid_ring' ||
        dropType == 'raid_head' ||
        dropType == 'raid_hands' ||
        dropType == 'raid_feet' ||
        dropType == 'upgrade_accessory' ||
        dropType == 'tome_weapon_token' ||
        dropType == 'raid_body' ||
        dropType == 'raid_legs' ||
        dropType == 'upgrade_armor' ||
        dropType == 'upgrade_weapon' ||
        dropType == 'raid_weapon' ||
        dropType == 'direct_weapon' ||
        dropType == 'music' ||
        dropType == 'mount';
    }

    function validRaidLootDropFloor(data) {
      return (
          data.floor == 1 &&
          (
            data.dropType == 'raid_earrings' ||
            data.dropType == 'raid_necklace' ||
            data.dropType == 'raid_bracelets' ||
            data.dropType == 'raid_ring'
          )
        ) ||
        (
          data.floor == 2 &&
          (
            data.dropType == 'raid_head' ||
            data.dropType == 'raid_hands' ||
            data.dropType == 'raid_feet' ||
            data.dropType == 'upgrade_accessory' ||
            data.dropType == 'tome_weapon_token'
          )
        ) ||
        (
          data.floor == 3 &&
          (
            data.dropType == 'raid_body' ||
            data.dropType == 'raid_legs' ||
            data.dropType == 'upgrade_armor' ||
            data.dropType == 'upgrade_weapon'
          )
        ) ||
        (
          data.floor == 4 &&
          (
            data.dropType == 'raid_weapon' ||
            data.dropType == 'direct_weapon' ||
            data.dropType == 'music' ||
            data.dropType == 'mount'
          )
        );
    }

    function validRaidLootGearTarget(data) {
      return (data.dropType == 'raid_earrings' && data.gearSlot == 'earrings') ||
        (data.dropType == 'raid_necklace' && data.gearSlot == 'necklace') ||
        (data.dropType == 'raid_bracelets' && data.gearSlot == 'bracelets') ||
        (data.dropType == 'raid_ring' && (data.gearSlot == 'ring1' || data.gearSlot == 'ring2')) ||
        (data.dropType == 'raid_head' && data.gearSlot == 'head') ||
        (data.dropType == 'raid_hands' && data.gearSlot == 'hands') ||
        (data.dropType == 'raid_feet' && data.gearSlot == 'feet') ||
        (
          data.dropType == 'upgrade_accessory' &&
          (
            data.gearSlot == 'earrings' ||
            data.gearSlot == 'necklace' ||
            data.gearSlot == 'bracelets' ||
            data.gearSlot == 'ring1' ||
            data.gearSlot == 'ring2'
          )
        ) ||
        (data.dropType == 'raid_body' && data.gearSlot == 'body') ||
        (data.dropType == 'raid_legs' && data.gearSlot == 'legs') ||
        (
          data.dropType == 'upgrade_armor' &&
          (
            data.gearSlot == 'head' ||
            data.gearSlot == 'body' ||
            data.gearSlot == 'hands' ||
            data.gearSlot == 'legs' ||
            data.gearSlot == 'feet'
          )
        ) ||
        (data.dropType == 'upgrade_weapon' && data.gearSlot == 'weapon') ||
        (data.dropType == 'raid_weapon' && data.gearSlot == 'weapon') ||
        (data.dropType == 'direct_weapon' && data.gearSlot == 'weapon') ||
        (
          (
            data.dropType == 'tome_weapon_token' ||
            data.dropType == 'music' ||
            data.dropType == 'mount'
          ) &&
          data.gearSlot == ''
        );
    }

    function validRaidLootDropJob(data) {
      return (
          data.dropType == 'direct_weapon' &&
          data.job.size() > 0
        ) ||
        (
          data.dropType != 'direct_weapon' &&
          data.job == ''
        );
    }

    function validRaidLootEventBase(data) {
      return data.week is int &&
        data.week >= 1 &&
        data.week <= 8 &&
        data.floor is int &&
        data.floor >= 1 &&
        data.floor <= 4 &&
        validRaidLootDropType(data.dropType) &&
        validRaidLootDropFloor(data) &&
        data.note is string &&
        data.note == data.note.trim() &&
        data.note.size() <= 200 &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.createdBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function validRaidLootAward(data) {
      return data.keys().hasAll([
          'action',
          'week',
          'floor',
          'dropType',
          'seat',
          'gearSlot',
          'job',
          'source',
          'decision',
          'countsForFairness',
          'note',
          'createdBy',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'action',
          'week',
          'floor',
          'dropType',
          'seat',
          'gearSlot',
          'job',
          'source',
          'decision',
          'countsForFairness',
          'note',
          'createdBy',
          'createdAt'
        ]) &&
        data.action == 'award' &&
        validRaidLootEventBase(data) &&
        validRaidLootSeat(data.seat) &&
        data.gearSlot is string &&
        (data.gearSlot == '' || validRaidLootGearSlot(data.gearSlot)) &&
        validRaidLootGearTarget(data) &&
        data.job is string &&
        data.job == data.job.trim() &&
        data.job.size() <= 30 &&
        validRaidLootDropJob(data) &&
        (
          data.source == 'raid' ||
          data.source == 'book' ||
          data.source == 'external' ||
          data.source == 'other'
        ) &&
        (
          data.decision == 'recommended' ||
          data.decision == 'manual' ||
          data.decision == 'free'
        ) &&
        data.countsForFairness is bool;
    }

    function validRaidLootSkip(data) {
      return data.keys().hasAll([
          'action',
          'week',
          'floor',
          'dropType',
          'job',
          'reason',
          'note',
          'createdBy',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'action',
          'week',
          'floor',
          'dropType',
          'job',
          'reason',
          'note',
          'createdBy',
          'createdAt'
        ]) &&
        data.action == 'skip' &&
        validRaidLootEventBase(data) &&
        data.job is string &&
        data.job == data.job.trim() &&
        data.job.size() <= 30 &&
        validRaidLootDropJob(data) &&
        (
          data.reason == 'unclaimed' ||
          data.reason == 'external' ||
          data.reason == 'deferred'
        );
    }

    function validRaidLootUndo(data) {
      return data.keys().hasAll([
          'action',
          'targetEventId',
          'note',
          'createdBy',
          'createdAt'
        ]) &&
        data.keys().hasOnly([
          'action',
          'targetEventId',
          'note',
          'createdBy',
          'createdAt'
        ]) &&
        data.action == 'undo' &&
        validRaidLootEventId(data.targetEventId) &&
        data.note is string &&
        data.note == data.note.trim() &&
        data.note.size() <= 200 &&
        data.createdBy is string &&
        data.createdBy.size() > 0 &&
        data.createdBy.size() <= 128 &&
        data.createdAt is timestamp;
    }

    function validRaidLootEvent(data) {
      return data is map &&
        (
          validRaidLootAward(data) ||
          validRaidLootSkip(data) ||
          validRaidLootUndo(data)
        );
    }

    function validPollChoice(choice) {
      return choice == 'agree' ||
        choice == 'reject' ||
        choice == 'neutral';
    }

    function validPollBallotKey(ballotKey) {
      return ballotKey is string &&
        ballotKey.matches('[A-Za-z0-9_-]{22}');
    }

    function validPollRoom(data) {
      return data.keys().hasAll([
          'version',
          'agenda',
          'description',
          'ownerUid',
          'locked',
          'createdAt',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'version',
          'agenda',
          'description',
          'ownerUid',
          'locked',
          'createdAt',
          'updatedAt'
        ]) &&
        data.version is int &&
        data.version == 1 &&
        data.agenda is string &&
        data.agenda == data.agenda.trim() &&
        data.agenda.size() > 0 &&
        data.agenda.size() <= 160 &&
        data.description is string &&
        data.description == data.description.trim() &&
        data.description.size() <= 500 &&
        data.ownerUid is string &&
        data.ownerUid.size() > 0 &&
        data.ownerUid.size() <= 128 &&
        data.locked is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validPollBallot(data) {
      return data.keys().hasAll(['votes', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['votes', 'createdAt', 'updatedAt']) &&
        data.votes is map &&
        data.votes.size() <= 100 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validPollVote(data) {
      return data.keys().hasAll(['choice', 'ballotKey', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['choice', 'ballotKey', 'createdAt', 'updatedAt']) &&
        validPollChoice(data.choice) &&
        validPollBallotKey(data.ballotKey) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function validPollBallotTransition(beforeBallot, afterBallot, ballotKey, beforeChoice, afterChoice, firstVote) {
      let changes = afterBallot.diff(beforeBallot).affectedKeys();
      let voteChanges = afterBallot.votes.diff(beforeBallot.votes);
      return validPollBallot(beforeBallot) &&
        validPollBallot(afterBallot) &&
        validPollBallotKey(ballotKey) &&
        validPollChoice(afterChoice) &&
        changes.hasOnly(['votes', 'updatedAt']) &&
        changes.hasAll(['votes', 'updatedAt']) &&
        voteChanges.affectedKeys().hasOnly([ballotKey]) &&
        voteChanges.affectedKeys().hasAll([ballotKey]) &&
        afterBallot.createdAt == beforeBallot.createdAt &&
        afterBallot.updatedAt == request.time &&
        afterBallot.votes[ballotKey] == afterChoice &&
        (
          (
            firstVote == true &&
            !(ballotKey in beforeBallot.votes) &&
            beforeBallot.votes.size() < 100 &&
            afterBallot.votes.size() == beforeBallot.votes.size() + 1
          ) ||
          (
            firstVote == false &&
            validPollChoice(beforeChoice) &&
            beforeChoice != afterChoice &&
            ballotKey in beforeBallot.votes &&
            beforeBallot.votes[ballotKey] == beforeChoice &&
            afterBallot.votes.size() == beforeBallot.votes.size()
          )
        );
    }

    function validInitialPollBallot(roomId) {
      let ballot = getAfter(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current);
      return existsAfter(/databases/$(database)/documents/pollRooms/$(roomId)/ballots/current) &&
        validPollBallot(ballot.data) &&
        ballot.data.votes.size() == 0 &&
        ballot.data.createdAt == request.time &&
        ballot.data.updatedAt == request.time;
    }

    match /rooms/{roomId} {
      function owner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function participantResponseChange() {
        let topLevelChanges = request.resource.data.diff(resource.data).affectedKeys();
        let responseChanges = request.resource.data.responses.diff(resource.data.responses).affectedKeys();
        return signedIn() &&
          resource.data.locked == false &&
          validRoom(request.resource.data) &&
          topLevelChanges.hasOnly(['responses']) &&
          topLevelChanges.hasAll(['responses']) &&
          responseChanges.hasOnly([request.auth.uid]) &&
          responseChanges.hasAll([request.auth.uid]) &&
          (
            !(request.auth.uid in request.resource.data.responses) ||
            validResponse(request.resource.data.responses[request.auth.uid])
          );
      }

      function ownerMetadataChange() {
        let changes = request.resource.data.diff(resource.data).affectedKeys();
        return owner() &&
          validRoom(request.resource.data) &&
          changes.hasOnly(['title', 'locked', 'updatedAt']) &&
          changes.hasAll(['updatedAt']) &&
          request.resource.data.updatedAt == request.time;
      }

      function ownerResponseRemoval() {
        let topLevelChanges = request.resource.data.diff(resource.data).affectedKeys();
        let responseChanges = request.resource.data.responses.diff(resource.data.responses);
        return owner() &&
          validRoom(request.resource.data) &&
          topLevelChanges.hasOnly(['responses', 'updatedAt']) &&
          topLevelChanges.hasAll(['responses', 'updatedAt']) &&
          responseChanges.addedKeys().size() == 0 &&
          responseChanges.changedKeys().size() == 0 &&
          responseChanges.removedKeys().size() > 0 &&
          request.resource.data.updatedAt == request.time;
      }

      allow get: if signedIn() && validRoomId(roomId);
      allow list: if googleAccount() &&
        resource.data.ownerUid == request.auth.uid &&
        request.query.limit <= 30;

      allow create: if googleAccount() &&
        validRoomId(roomId) &&
        validRoom(request.resource.data) &&
        'startDate' in request.resource.data &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.locked == false &&
        request.resource.data.responses.size() == 0 &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;

      allow update: if participantResponseChange() ||
        ownerMetadataChange() ||
        ownerResponseRemoval();

      allow delete: if owner();
    }

    match /bisRooms/{roomId} {
      function bisOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function bisOwnerUpdate() {
        let changes = request.resource.data.diff(resource.data).affectedKeys();
        return bisOwner() &&
          validBisRoom(request.resource.data) &&
          changes.hasOnly(['title', 'tier', 'week', 'locked', 'distribution', 'updatedAt']) &&
          changes.hasAll(['updatedAt']) &&
          request.resource.data.updatedAt == request.time;
      }

      allow get: if signedIn() && validRoomId(roomId);
      allow list: if googleAccount() &&
        resource.data.ownerUid == request.auth.uid &&
        request.query.limit <= 30;

      allow create: if googleAccount() &&
        validRoomId(roomId) &&
        validBisRoom(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.locked == false &&
        request.resource.data.distribution.week == request.resource.data.week &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        allBisMembersExistAfter(roomId);

      allow update: if bisOwnerUpdate();

      allow delete: if bisOwner() && noBisMembersExistAfter(roomId);

      match /members/{seat} {
        function parentBefore() {
          return get(/databases/$(database)/documents/bisRooms/$(roomId));
        }

        function parentAfter() {
          return getAfter(/databases/$(database)/documents/bisRooms/$(roomId));
        }

        function parentOwner() {
          return signedIn() && parentBefore().data.ownerUid == request.auth.uid;
        }

        function noOtherBisSeatClaimedByRequester() {
          return (seat == 'MT' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/MT).data.editorUid != request.auth.uid) &&
            (seat == 'ST' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/ST).data.editorUid != request.auth.uid) &&
            (seat == 'MH' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/MH).data.editorUid != request.auth.uid) &&
            (seat == 'SH' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/SH).data.editorUid != request.auth.uid) &&
            (seat == 'D1' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D1).data.editorUid != request.auth.uid) &&
            (seat == 'D2' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D2).data.editorUid != request.auth.uid) &&
            (seat == 'D3' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D3).data.editorUid != request.auth.uid) &&
            (seat == 'D4' || getAfter(/databases/$(database)/documents/bisRooms/$(roomId)/members/D4).data.editorUid != request.auth.uid);
        }

        function participantMemberUpdate() {
          let changes = request.resource.data.diff(resource.data).affectedKeys();
          return signedIn() &&
            parentBefore().data.locked == false &&
            validBisMember(request.resource.data, seat) &&
            request.resource.data.seat == resource.data.seat &&
            request.resource.data.nickname == resource.data.nickname &&
            request.resource.data.job == resource.data.job &&
            changes.hasOnly(['editorUid', 'gear', 'submitted', 'updatedAt']) &&
            changes.hasAll(['updatedAt']) &&
            (
              (
                resource.data.editorUid == '' &&
                request.resource.data.editorUid == request.auth.uid &&
                noOtherBisSeatClaimedByRequester()
              ) ||
              (
                resource.data.editorUid == request.auth.uid &&
                request.resource.data.editorUid == request.auth.uid
              )
            ) &&
            request.resource.data.updatedAt == request.time;
        }

        function ownerMemberUpdate() {
          let changes = request.resource.data.diff(resource.data).affectedKeys();
          return parentOwner() &&
            validBisMember(request.resource.data, seat) &&
            request.resource.data.seat == resource.data.seat &&
            request.resource.data.nickname == resource.data.nickname &&
            request.resource.data.job == resource.data.job &&
            changes.hasOnly(['editorUid', 'gear', 'submitted', 'updatedAt']) &&
            changes.hasAll(['updatedAt']) &&
            request.resource.data.updatedAt == request.time;
        }

        allow get: if signedIn() && validRoomId(roomId) && validBisSeat(seat);
        allow list: if signedIn() &&
          validRoomId(roomId) &&
          request.query.limit <= 8;

        allow create: if googleAccount() &&
          validRoomId(roomId) &&
          validBisMember(request.resource.data, seat) &&
          request.resource.data.editorUid == '' &&
          request.resource.data.gear == 'XXXXXXXXXXX' &&
          request.resource.data.submitted == false &&
          request.resource.data.updatedAt == request.time &&
          !exists(/databases/$(database)/documents/bisRooms/$(roomId)) &&
          parentAfter().data.ownerUid == request.auth.uid;

        allow update: if participantMemberUpdate() || ownerMemberUpdate();

        allow delete: if parentOwner() &&
          !existsAfter(/databases/$(database)/documents/bisRooms/$(roomId));
      }
    }

    match /raidLootRooms/{roomId} {
      function raidLootOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function raidLootOwnerUpdate() {
        let changes = request.resource.data.diff(resource.data).affectedKeys();
        return raidLootOwner() &&
