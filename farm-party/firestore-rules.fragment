    function farmGoogleAccount() {
      return request.auth != null && request.auth.token.firebase.identities is map && 'google.com' in request.auth.token.firebase.identities;
    }
    function validFarmRoomId(roomId) {
      return roomId.matches('[A-Za-z0-9_-]{22}');
    }
    function validFarmPreferences(data) {
      return data is map && data.keys().hasAll(['T1', 'T2', 'H1', 'H2', 'D1', 'D2', 'D3', 'D4']) &&
        data.keys().hasOnly(['T1', 'T2', 'H1', 'H2', 'D1', 'D2', 'D3', 'D4']) &&
        data.T1 in [0, 1, 2] && data.T2 in [0, 1, 2] && data.H1 in [0, 1, 2] && data.H2 in [0, 1, 2] &&
        data.D1 in [0, 1, 2] && data.D2 in [0, 1, 2] && data.D3 in [0, 1, 2] && data.D4 in [0, 1, 2] &&
        data.T1 + data.T2 + data.H1 + data.H2 + data.D1 + data.D2 + data.D3 + data.D4 > 0;
    }
    function validFarmPerson(data) {
      return data.nickname is string && data.nickname == data.nickname.trim() && data.nickname.size() > 0 && data.nickname.size() <= 30 &&
        data.server is string && data.server == data.server.trim() && data.server.size() <= 20 &&
        data.memo is string && data.memo == data.memo.trim() && data.memo.size() <= 200 && validFarmPreferences(data.preferences);
    }
    function validFarmApplicant(data) {
      return data is map && data.keys().hasAll(['nickname', 'server', 'memo', 'preferences', 'wing', 'joinedAt', 'updatedAt']) &&
        data.keys().hasOnly(['nickname', 'server', 'memo', 'preferences', 'wing', 'joinedAt', 'updatedAt']) &&
        validFarmPerson(data) && data.wing is bool && data.joinedAt is timestamp && data.updatedAt == request.time;
    }
    function validFarmSeat(data, seat) {
      return !(seat in data.assignments) || (
        data.assignments[seat] is string && data.assignments[seat] in data.applicants &&
        data.applicants[data.assignments[seat]].preferences[seat] in [1, 2]
      );
    }
    function validFarmLock(data, seat) {
      return !(seat in data.locks) || (data.locks[seat] == true && seat in data.assignments);
    }
    function validFarmRoom(data) {
      return data.keys().hasAll(['version', 'trial', 'title', 'description', 'date', 'time', 'ownerUid', 'status', 'applicants', 'assignments', 'locks', 'revision', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['version', 'trial', 'title', 'description', 'date', 'time', 'ownerUid', 'status', 'applicants', 'assignments', 'locks', 'revision', 'createdAt', 'updatedAt']) &&
        data.version == 1 && data.trial is int && data.trial >= 0 && data.trial < 7 &&
        data.title is string && data.title == data.title.trim() && data.title.size() > 0 && data.title.size() <= 60 &&
        data.description is string && data.description == data.description.trim() && data.description.size() <= 500 &&
        data.date is string && data.date.matches('[1-9][0-9]{3}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])') &&
        data.time is string && data.time.matches('([01][0-9]|2[0-3]):[0-5][0-9]') &&
        data.ownerUid is string && data.ownerUid.size() > 0 && data.ownerUid.size() <= 128 &&
        data.status in ['open', 'confirmed', 'closed'] && data.applicants is map && data.applicants.size() <= 100 &&
        data.assignments is map && data.assignments.keys().hasOnly(['T1', 'T2', 'H1', 'H2', 'D1', 'D2', 'D3', 'D4']) &&
        data.assignments.values().toSet().size() == data.assignments.size() &&
        data.locks is map && data.locks.keys().hasOnly(['T1', 'T2', 'H1', 'H2', 'D1', 'D2', 'D3', 'D4']) &&
        (data.assignments.size() == 0 || (validFarmSeat(data, 'T1') && validFarmSeat(data, 'T2') && validFarmSeat(data, 'H1') && validFarmSeat(data, 'H2') &&
        validFarmSeat(data, 'D1') && validFarmSeat(data, 'D2') && validFarmSeat(data, 'D3') && validFarmSeat(data, 'D4'))) &&
        (data.locks.size() == 0 || (validFarmLock(data, 'T1') && validFarmLock(data, 'T2') && validFarmLock(data, 'H1') && validFarmLock(data, 'H2') &&
        validFarmLock(data, 'D1') && validFarmLock(data, 'D2') && validFarmLock(data, 'D3') && validFarmLock(data, 'D4'))) &&
        (data.status != 'confirmed' || data.assignments.size() == 8) &&
        data.revision is int && data.revision >= 0 && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /farmRooms/{roomId} {
      function farmOwner() {
        return signedIn() && farmGoogleAccount() && resource.data.ownerUid == request.auth.uid;
      }
      function farmOwnSeatRemoval(seat, changedSeats, changedLocks) {
        let before = resource.data;
        let after = request.resource.data;
        return (
          !changedSeats.hasAny([seat]) && !changedLocks.hasAny([seat])
        ) || (
          seat in before.assignments && before.assignments[seat] == request.auth.uid &&
          !(seat in after.assignments) && !(seat in after.locks) &&
          (!(request.auth.uid in after.applicants) || after.applicants[request.auth.uid].preferences[seat] == 0)
        );
      }
      function farmSelfUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        let changed = after.applicants.diff(before.applicants).affectedKeys();
        let changedSeats = after.assignments.diff(before.assignments).affectedKeys();
        let changedLocks = after.locks.diff(before.locks).affectedKeys();
        return before.status == 'open' && after.status == 'open' &&
          after.diff(before).affectedKeys().hasOnly(['applicants', 'assignments', 'locks', 'revision', 'updatedAt']) &&
          after.applicants.size() <= 100 &&
          changed.hasOnly([request.auth.uid]) && changed.hasAll([request.auth.uid]) &&
          (
            !(request.auth.uid in after.applicants) || (
              validFarmApplicant(after.applicants[request.auth.uid]) &&
              after.applicants[request.auth.uid].joinedAt == (request.auth.uid in before.applicants ? before.applicants[request.auth.uid].joinedAt : request.time)
            )
          ) &&
          (changedSeats.size() == 0 && changedLocks.size() == 0 || (
            changedSeats.hasOnly(['T1', 'T2', 'H1', 'H2', 'D1', 'D2', 'D3', 'D4']) &&
            changedLocks.hasOnly(['T1', 'T2', 'H1', 'H2', 'D1', 'D2', 'D3', 'D4']) &&
            farmOwnSeatRemoval('T1', changedSeats, changedLocks) && farmOwnSeatRemoval('T2', changedSeats, changedLocks) &&
            farmOwnSeatRemoval('H1', changedSeats, changedLocks) && farmOwnSeatRemoval('H2', changedSeats, changedLocks) &&
            farmOwnSeatRemoval('D1', changedSeats, changedLocks) && farmOwnSeatRemoval('D2', changedSeats, changedLocks) &&
            farmOwnSeatRemoval('D3', changedSeats, changedLocks) && farmOwnSeatRemoval('D4', changedSeats, changedLocks)
          ));
      }
      function farmOwnerUpdate() {
        let before = resource.data;
        let after = request.resource.data;
        return farmOwner() && before.status != 'closed' &&
          after.diff(before).affectedKeys().hasOnly(['status', 'assignments', 'locks', 'revision', 'updatedAt']) &&
          (
            before.status == 'open' ||
            (before.status == 'confirmed' && after.status in ['open', 'closed'] && after.assignments == before.assignments && after.locks == before.locks)
          );
      }
      allow get: if signedIn() && validFarmRoomId(roomId);
      allow list: if signedIn() && request.query.limit != null && request.query.limit <= 30 &&
        (resource.data.status in ['open', 'confirmed'] || resource.data.ownerUid == request.auth.uid);
      allow create: if farmGoogleAccount() && validFarmRoomId(roomId) && validFarmRoom(request.resource.data) &&
        request.resource.data.ownerUid == request.auth.uid && request.resource.data.status == 'open' &&
        request.resource.data.applicants.size() == 0 && request.resource.data.assignments.size() == 0 && request.resource.data.locks.size() == 0 &&
        request.resource.data.revision == 0 && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && validFarmRoomId(roomId) &&
        request.resource.data.revision == resource.data.revision + 1 && request.resource.data.updatedAt == request.time &&
        ((farmOwnerUpdate() && validFarmRoom(request.resource.data)) || farmSelfUpdate());
      allow delete: if false;
    }
    match /farmProfiles/{userId} {
      function validFarmProfile(data) {
        return data.keys().hasAll(['version', 'nickname', 'server', 'memo', 'preferences', 'wings', 'updatedAt']) &&
          data.keys().hasOnly(['version', 'nickname', 'server', 'memo', 'preferences', 'wings', 'updatedAt']) &&
          data.version == 1 && validFarmPerson(data) && data.wings is list && data.wings.size() == 7 &&
          data.wings[0] is bool && data.wings[1] is bool && data.wings[2] is bool && data.wings[3] is bool &&
          data.wings[4] is bool && data.wings[5] is bool && data.wings[6] is bool && data.updatedAt == request.time;
      }
      allow get: if farmGoogleAccount() && userId == request.auth.uid;
      allow list: if false;
      allow create, update: if farmGoogleAccount() && userId == request.auth.uid && validFarmProfile(request.resource.data);
      allow delete: if false;
    }
